sha256 tools/l5-deploy-gate-selftest.sh 1189af35d867957c5cadb7fd2c9bc3c0b9e4c6e27b7d454c7a5b7fab0b84910a
sha256 tools/l6-deploy-gate-selftest.sh f6435ac0d7b40fcd64dfb349f0dee93ca1e67d26e082a0a1780179f4d8559ef3
sha256 tools/publish-live-surface-probe.py 5c70a8ce433bfd18eb31d81f768d81e645ab1c118fba28fcca5638cc80828c5f
