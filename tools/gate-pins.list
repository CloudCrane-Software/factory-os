# tools/gate-pins.list — 门本体钉桩面（权威值外置于门本体）
#
# 为什么有这份文件（2026-11-03 RT-CI门本体批，红队已确证发现）：
#   tools/ 与工作区根都不在任何 git 仓内（git -C tools rev-parse → fatal: 不是 Git
#   仓库），故门本体内硬编码的钉值（L2_MIN_ITEMS / L1_MIN_PY）此前是「零版本面、
#   零完整性绑定」资产：改它既无版本面可查，也无任何机检消费其摘要；而门本体
#   对它的自证立论「改门=纪律红线，门面 diff 即见」在本仓不成立（没有 diff 面）。
#   攻击链（结构推演，本批已用沙箱负控实证）：改门内钉值 + 删 test-*.py + 删清单行
#   + 下调清单声明 + 追加一行变更日志登记 → RT-E84②③ 两侧对账同时通过、exit=0；
#   或把任一子探针改成恒 exit 0 → 全门无一处能红。
#
# 本文件是钉桩面（权威值在门本体之外），三面绑定：
#   ① 本文件自身 sha256 须登记在 计划/变更日志.md（登记串：
#      tools/gate-pins.list sha256=<64位hex>）——tools/ 唯一的版本面（RT-E84④ 同款口径）；
#   ② 门本体 all-gates.sh 的 sha256 记在本文件内（改门 → 本文件失配 → 钉桩对账红）；
#   ③ 每个被钉件的 sha256 记在本文件内（改探针 → 失配 → 红）。
# 维护契约（缺一即红，改后跑一条命令重锚）：
#   改门本体 / 改子探针 / 改钉值 → bash tools/gate-pins-refresh.sh
#   （重算全部摘要 + 追加变更日志登记行 + 复验；勿手改本文件的 sha256 行）。
#
# 格式：
#   KEY=VALUE 行          —— 门件件数下限等钉值
#   sha256 <相对路径> <64位小写hex> 行 —— 被钉件摘要（相对工作区根）
#   以 # 开头的行为注释
PINS_FORMAT=1
# --- 门件件数下限（RT-E84②③ 的「门内钉值」：原写在门本体硬编码常量里，本批外置）---
# L2_MIN_ITEMS：L2 在列门件件数下限。有效下限 = max(本值, 清单声明 #L2_ITEMS_COUNT)。
#   本值取 31 = 2026-11-03 05:5x 亲数（清单在列 31 件，与门本体原硬编码值同值，
#   本批只搬位置不改语义）；新增/下线门件须同步本值 + 清单行 + 清单声明三处。
L2_MIN_ITEMS=32
# L1_MIN_PY：L1 在册 py_compile 件数下限。有效下限 = max(本值, 清单声明 #L1_PY_COUNT_MIN=96)。
#   本值取 91 = 门本体原硬编码值（同值搬位，不改语义）。
L1_MIN_PY=91
# --- 被钉件摘要（改任一件 → 须跑 tools/gate-pins-refresh.sh 重锚，否则钉桩对账红）---
sha256 tools/all-gates.sh 52bad50059e6f6c85eb4e71017acd20218b35d8f41513344e622b5d143bfc9ef
sha256 tools/deploy-consistency-probe.sh a9a9b29c809f78d80b4b9d7656cd4746baefb2c595c7bd90350d9810c4985890
