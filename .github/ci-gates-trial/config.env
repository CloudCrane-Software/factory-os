# D-89 点选试跑配置（org ci-gates.yml workflow_dispatch 面 g2_trial_config 消费；
# KEY=CI_G2_* 与 workflow_call 面同名入参；只填显式入参留空的键）。与本仓 caller
# workflow 的 with: 传参同值（双通道等价：caller 面走 with、dispatch 面走本文件）。
CI_G2_PIN_LIST=.github/ci-gates-trial/gate-inputs.list
CI_G2_PIN_VALUES=.github/ci-gates-trial/gate-inputs.sha256
CI_G2_PIN_SCAN_DIR=.github/ci-gates-trial/scan-root
CI_G2_PIN_SCAN_EXTS=yaml yml json tsv txt md
CI_G2_PIN_EXCLUSIONS=.github/ci-gates-trial/gate-inputs-exclusions.list
CI_G2_SCALE_CMD=python3 -I .github/ci-gates-trial/scale.py
CI_G2_RODS=.github/ci-gates-trial/gates-budget-rods.list
CI_G2_MARGIN=800
CI_G2_FLOOR_MS=900000
CI_G2_HYGIENE_DIR=.github/workflows
CI_G2_LINT_PATHS=.github/ci-gates-trial/lint-target

# —— 批3 点选试跑配置（D-90：A-2 名册四面对账＋A-6 变异演练同批；CI_G3_* 键经 g2_trial_config 消费）——
CI_G3_ROSTER_LIST=tools/test-manifest.list
CI_G3_ROSTER_ROOT=tools
CI_G3_COUNT_KEY=L2_ITEMS_COUNT
CI_G3_MIN_KEY=L1_PY_COUNT_MIN
CI_G3_COUNT_MIN=96
CI_G3_CHANGELOG=.github/ci-gates-trial/roster-changelog.list
CI_G3_COUNTED_CMD=find tools -maxdepth 2 -name "*.py" | wc -l
CI_G3_MUT_TARGET=test-minimax-dispatch-gate.py
